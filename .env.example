# Backend API Base URL
# For Local Development: leave blank to use the Vite proxy, or set http://localhost:8000
# For Vercel Production: set to your deployed backend URL (e.g. https://voxpay-backend.onrender.com)
VITE_API_URL=http://localhost:8000

# Groq AI API Key (for GenAI Financial Counselor)
# Get yours at: https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here
